# AI-OS configuration — copy to `.env` and fill in. NEVER commit `.env`.

# Which provider to use: "claude" (default), "openrouter", or "groq".
AI_OS_PROVIDER=claude

# --- Provider: Claude (default) ---
# Your Anthropic API key (https://console.anthropic.com/). Required when AI_OS_PROVIDER=claude.
ANTHROPIC_API_KEY=

# --- Provider: OpenRouter (no Anthropic key needed) ---
# One key, many models — including FREE ones. Get a key at https://openrouter.ai/keys.
# Required when AI_OS_PROVIDER=openrouter. Install the client: pip install -e ".[openrouter]"
OPENROUTER_API_KEY=

# --- Provider: Groq (free tier, very fast) ---
# OpenAI-compatible; free key at https://console.groq.com/keys.
# Required when AI_OS_PROVIDER=groq. Install the client: pip install -e ".[groq]"
GROQ_API_KEY=

# Optional: default model. Leave blank to use the provider's default.
#   claude:     claude-opus-4-8 (default) · claude-sonnet-5 · claude-haiku-4-5 · claude-fable-5
#   openrouter: pick a FREE model at https://openrouter.ai/models?max_price=0
#               (default: google/gemma-4-31b-it:free)
#   groq:       see https://console.groq.com/docs/models (default: openai/gpt-oss-120b)
#               note: strict structured output (Topics 02/08/09) needs a json_schema-capable
#               model such as openai/gpt-oss-120b; llama-3.3-70b-versatile does tools but not that.
# AI_OS_DEFAULT_MODEL=

# Optional: default output cap for demos (kept small to control cost)
AI_OS_MAX_TOKENS=1024

# --- MCP: external servers consumed by core.mcp_client (Topic 07) ---
# The live manifest is mcp/servers.json (git-ignored; copy from mcp/servers.example.json).
# These vars are expanded into it via ${VAR}. Leave blank to disable that server.
#
# Filesystem MCP — scopes file read/edit to ONE project (least privilege). Needs Node/npx.
AI_OS_TARGET_DIR=
# Documentation MCP target tree (filesystem-backed placeholder).
AI_OS_DOCS_DIR=
# GitHub MCP (PRs/branches/issues) — a fine-grained personal access token.
GITHUB_TOKEN=
# Deployment MCP (remote HTTP server exposing deploy/rollback/status tools).
AI_OS_DEPLOY_MCP_URL=
AI_OS_DEPLOY_TOKEN=
# Query-optimization MCP (remote HTTP server: EXPLAIN / index advice).
AI_OS_QUERYOPT_MCP_URL=
AI_OS_QUERYOPT_TOKEN=
