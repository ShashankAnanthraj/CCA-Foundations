# AI-OS configuration — copy to `.env` and fill in. NEVER commit `.env`.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: default model (model-agnostic core; swap freely)
#   claude-opus-4-8 (default) · claude-sonnet-5 · claude-haiku-4-5 · claude-fable-5
AI_OS_DEFAULT_MODEL=claude-opus-4-8

# Optional: default output cap for demos (kept small to control cost)
AI_OS_MAX_TOKENS=1024
